# Apple CloudKit Console > CloudKit Database > Tokens & Keys 中创建的 Web API Token。
# API Token 会发布到浏览器，必须在 CloudKit Console 限制 Allowed Origins。
VITE_CLOUDKIT_CONTAINER_ID=iCloud.com.hanqiu.peopleatlas
VITE_CLOUDKIT_API_TOKEN=replace-with-cloudkit-web-api-token
VITE_CLOUDKIT_ENVIRONMENT=development
VITE_BASE_PATH=/
